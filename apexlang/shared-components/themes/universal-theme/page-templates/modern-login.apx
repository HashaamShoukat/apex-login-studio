            .ml-Scheme--dark.ml-Bg--topo .ml-Bg::before { opacity: .42; background: var(--ml-accent-2); }
            .ml-Bg--rings .ml-Bg { background: repeating-radial-gradient(circle at 100% 100%, transparent 0 44px, color-mix(in srgb, var(--ml-accent) 22%, transparent) 44px 46px),
                                               radial-gradient(circle at 0 0, color-mix(in srgb, var(--ml-accent-2) 22%, transparent), transparent 45%), var(--ml-bg); }
            .ml-Bg--grid .ml-Bg {
              background: radial-gradient(ellipse 70% 55% at 50% 0%, color-mix(in srgb, var(--ml-accent) 20%, transparent), transparent 70%),
                          linear-gradient(color-mix(in srgb, var(--ml-text) 7%, transparent) 1px, transparent 1px) 0 0 / 40px 40px,
                          linear-gradient(90deg, color-mix(in srgb, var(--ml-text) 7%, transparent) 1px, transparent 1px) 0 0 / 40px 40px, var(--ml-bg);
            }

            </style>
            <div class="ml-Shell">
              <div class="ml-TopBar">#REGION_POSITION_05#</div>
              <aside class="ml-Brand"><div class="ml-Brand-inner">#REGION_POSITION_03#</div></aside>
              <div class="ml-Main">
                <div class="ml-Center">
                  <div class="ml-Card">
                    <div class="ml-Offline" role="status"><span class="ml-Offline-text">You are offline. Signing in needs a connection.</span></div>
                    <header class="ml-Card-header">#REGION_POSITION_01#</header>
                    <main class="ml-Card-body" id="main">#SUCCESS_MESSAGE##NOTIFICATION_MESSAGE##GLOBAL_NOTIFICATION##BODY#</main>
                    <footer class="ml-Card-footer">#REGION_POSITION_02#</footer>
                  </div>
                </div>
                <div class="ml-PageFooter">#REGION_POSITION_04#</div>
              </div>
            </div>
            ```
        footer:
            ```html
            #FORM_CLOSE#
            #DEVELOPER_TOOLBAR#
            #APEX_JAVASCRIPT#
            #GENERATED_CSS#
            #THEME_JAVASCRIPT#
            #TEMPLATE_JAVASCRIPT#
            #APPLICATION_JAVASCRIPT#
            #PAGE_JAVASCRIPT#
            #GENERATED_JAVASCRIPT#
            </body>
            </html>
            ```
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            apex.theme42.initializePage.appLogin();
            
            // Modern Login behaviour. Everything is switched by template options (body classes);
            // texts come from text messages MODERN_LOGIN.* when the app defines them, else English.
            (function ($, ml) {
                var body = document.body,
                    card = document.querySelector(".ml-Card"),
                    reduceMotion = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
            
                function has(cls) { return body.classList.contains(cls); }
                function msg(key, fallback) {
                    var t = apex.lang.getMessage(key);
                    return (!t || t === key) ? fallback : t;
                }
            
                // Login Designer preview: follow hash changes without a reload (a new background image needs one)
                var lastBg = (/[#&]bg=([^&]*)/.exec(window.location.hash) || [])[1];
                window.addEventListener("hashchange", function () {
                    var bg = (/[#&]bg=([^&]*)/.exec(window.location.hash) || [])[1];
                    if (bg !== lastBg) { window.location.reload(); return; }
                    ml.applyPreview(); ml.applyScheme();
                });
            
                // phone keyboards: no auto-capitalise / auto-correct on user names, "Go" on the password
                $(".ml-Card input[autocomplete=username], .ml-Card input[type=email]")
                    .attr({ autocapitalize: "none", autocorrect: "off", spellcheck: "false" });
                $(".ml-Card input[type=password]").last().attr("enterkeyhint", "go");
            
                // Caps Lock hint under password fields
                var capsText = msg("MODERN_LOGIN.CAPS_LOCK", "Caps Lock is on");
                $(document).on("keydown keyup", "input[type=password]", function (e) {
                    var ev = e.originalEvent;
                    if (!ev || typeof ev.getModifierState !== "function") { return; }
                    var box = $(this).closest(".t-Form-fieldContainer");
                    if (!box.find(".ml-capsHint").length) {
                        $('<div class="ml-capsHint" role="status"><span class="fa fa-arrow-up" aria-hidden="true"></span></div>')
                            .append(document.createTextNode(" " + capsText))
                            .appendTo(box.find(".t-Form-inputContainer").first());
                    }
                    box.toggleClass("ml-capsOn", ev.getModifierState("CapsLock"));
                }).on("blur", "input[type=password]", function () {
                    $(this).closest(".t-Form-fieldContainer").removeClass("ml-capsOn");
                });
            
                // Busy Button on Submit: spinner, no double submits
                $(document).on("apexpagesubmit", function () {
                    if (has("ml-Fx--busy")) { $(".ml-Card .t-Button--hot").addClass("is-busy").attr("aria-busy", "true"); }
                });
                window.addEventListener("pageshow", function () {
                    $(".ml-Card .t-Button--hot").removeClass("is-busy").removeAttr("aria-busy");
                });
            
                // Shake on Error: when the page returns with an error, or client-side validation fails
                var lastShake = 0;
                function shake() {
                    if (!card || !has("ml-Fx--shake") || reduceMotion || Date.now() - lastShake < 1500) { return; }
                    lastShake = Date.now();
                    card.classList.remove("ml-is-shaking");
                    void card.offsetWidth;
                    card.classList.add("ml-is-shaking");
                }
                if ($(".ml-Card #t_Alert_Notification, .ml-Card .t-Form-fieldContainer.is-error").length) { shake(); }
                var errBox = document.getElementById("APEX_ERROR_MESSAGE");
                if (errBox && window.MutationObserver) {
                    new MutationObserver(function () {
                        if (!errBox.classList.contains("u-hidden") && errBox.textContent.trim()) {
                            shake();
                            $(".ml-Card .t-Button--hot").removeClass("is-busy").removeAttr("aria-busy");
                        }
                    }).observe(errBox, { attributes: true, childList: true, subtree: true });
                }
                if (card) { card.addEventListener("animationend", function () { card.classList.remove("ml-is-shaking"); }); }
            
                // Connection Status: banner in the card while the device is offline
                $(".ml-Offline-text").text(msg("MODERN_LOGIN.OFFLINE", "You are offline. Signing in needs a connection."));
                function net() { body.classList.toggle("ml-is-offline", has("ml-Fx--offline") && navigator.onLine === false); }
                window.addEventListener("online", net);
                window.addEventListener("offline", net);
                net();
            
                // Theme Toggle: the visitor's own light / dark choice, remembered on the device
                $(".ml-ThemeToggle").attr("aria-label", msg("MODERN_LOGIN.THEME", "Switch between light and dark")).on("click", function () {
                    try { window.localStorage.setItem("ml-scheme", ml.isDark() ? "light" : "dark"); } catch (e) { /* private mode */ }
                    ml.applyScheme();
                    this.setAttribute("aria-pressed", ml.isDark() ? "true" : "false");
                }).attr("aria-pressed", ml.isDark() ? "true" : "false");
            
                // Slides: any .ml-Slides block becomes a carousel with dots and swipe; Auto-rotate Slides plays it
                $(".ml-Slides").each(function () {
                    var box = this, slides = $(box).children().toArray(), i = 0, timer = null, startX = null;
                    if (slides.length < 2) { return; }
                    var dots = $('<div class="ml-Dots" role="tablist"></div>');
                    function show(n) {
                        i = (n + slides.length) % slides.length;
                        slides.forEach(function (s, k) { s.classList.toggle("is-active", k === i); s.setAttribute("aria-hidden", k === i ? "false" : "true"); });
                        dots.children().each(function (k, d) { d.classList.toggle("is-active", k === i); d.setAttribute("aria-selected", k === i ? "true" : "false"); });
                    }
                    function stop() { if (timer) { clearInterval(timer); timer = null; } }
                    function play() {
                        stop();
                        if (has("ml-Fx--slides") && !reduceMotion) {
                            timer = setInterval(function () { if (!document.hidden) { show(i + 1); } }, 6000);
                        }
                    }
                    slides.forEach(function (s, n) {
                        $('<button type="button" class="ml-Dot" role="tab"></button>')
                            .attr("aria-label", (n + 1) + " / " + slides.length)
                            .on("click", function () { show(n); play(); })
                            .appendTo(dots);
                    });
                    $(box).addClass("is-ready").after(dots)
                        .on("mouseenter focusin", stop).on("mouseleave focusout", play)
                        .on("touchstart", function (e) { startX = e.originalEvent.touches[0].clientX; })
                        .on("touchend", function (e) {
                            if (startX === null) { return; }
                            var dx = e.originalEvent.changedTouches[0].clientX - startX;
                            startX = null;
                            if (Math.abs(dx) > 40) { show(i + (dx < 0 ? 1 : -1)); play(); }
                        });
                    show(0);
                    play();
                });
            })(apex.jQuery, window.modernLogin);
