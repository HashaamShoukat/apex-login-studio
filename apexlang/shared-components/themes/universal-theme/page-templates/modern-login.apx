pageTemplate modern-login (
    name: Modern Login
    templateClass: login
    templateOptions {
        default: [
            ml-Anim--entrance
            ml-Anim--bg
            ml-Fx--busy
            ml-Fx--shake
            ml-Fx--offline
            ml-Fx--slides
        ]
    }
    page {
        header:
            ```html
            <!DOCTYPE html>
            <html class="no-js #RTL_CLASS# page-&APP_PAGE_ID!ATTR. app-&APP_ALIAS!ATTR." lang="&BROWSER_LANGUAGE!ATTR." #TEXT_DIRECTION#>
            <head>
              <meta charset="utf-8">
              <title>#TITLE#</title>
              #APEX_CSS#
              #THEME_CSS#
              #TEMPLATE_CSS#
            <style id="ml-css-2">
            /* slides (carousel) */
            .ml-Slides { display: grid; }
            .ml-Slides > * { grid-area: 1 / 1; transition: opacity .5s ease, transform .5s ease, visibility .5s; }
            .ml-Slides > *:not(:first-child) { visibility: hidden; opacity: 0; }
            .ml-Slides.is-ready > * { visibility: hidden; opacity: 0; transform: translateY(6px); }
            .ml-Slides.is-ready > .is-active { visibility: visible; opacity: 1; transform: none; }
            .ml-Dots { display: flex; gap: .625rem; margin-block-start: 1rem; }
            .ml-Dot { position: relative; width: .5rem; height: .5rem; padding: 0; border: 0; border-radius: 999px; background: currentColor; opacity: .35; cursor: pointer; transition: width .3s ease, opacity .3s ease; }
            .ml-Dot::before { content: ""; position: absolute; inset: -.75rem -.25rem; }
            .ml-Dot.is-active { width: 1.5rem; opacity: .9; }
            
            /* split and floating layouts (wide screens) */
            @media (min-width: 861px) {
              .ml-Layout--splitRight .ml-Shell, .ml-Layout--floating .ml-Shell {
                grid-template-columns: minmax(0, 1fr) minmax(26rem, var(--ml-split-form)); grid-template-areas: "brand top" "brand main";
              }
              .ml-Layout--splitLeft .ml-Shell, .ml-Layout--floatingLeft .ml-Shell {
                grid-template-columns: minmax(26rem, var(--ml-split-form)) minmax(0, 1fr); grid-template-areas: "top brand" "main brand";
              }
              .ml-Layout--splitRight .ml-TopBar, .ml-Layout--splitLeft .ml-TopBar { background: var(--ml-surface); color: var(--ml-text); padding-inline: clamp(1.5rem, 4vw, 4rem); }
              .ml-Layout--splitRight .ml-TopBar { box-shadow: -1px 0 0 var(--ml-border); }
              .ml-Layout--splitLeft .ml-TopBar { box-shadow: 1px 0 0 var(--ml-border); }
              .ml-Layout--floating .ml-TopBar, .ml-Layout--floatingLeft .ml-TopBar { padding-inline: clamp(1rem, 4vw, 4rem); }
              .ml-Layout--splitRight .ml-Brand, .ml-Layout--splitLeft .ml-Brand, .ml-Layout--floating .ml-Brand, .ml-Layout--floatingLeft .ml-Brand {
                display: flex; align-items: center; justify-content: center; padding: clamp(2rem, 6vw, 5rem);
              }
              .ml-Layout--splitRight .ml-Brand::before, .ml-Layout--splitLeft .ml-Brand::before {
                content: ""; position: absolute; inset: 0;
                background: linear-gradient(150deg, color-mix(in srgb, var(--ml-accent) 80%, transparent), color-mix(in srgb, var(--ml-accent-2) 58%, transparent));
              }
              .ml-Layout--splitRight .ml-Main, .ml-Layout--splitLeft .ml-Main { --ml-on-bg: var(--ml-muted); --ml-on-bg-strong: var(--ml-text); background: var(--ml-surface); padding-inline: clamp(1.5rem, 4vw, 4rem); }
              .ml-Layout--splitRight .ml-Main { box-shadow: -1px 0 0 var(--ml-border); }
              .ml-Layout--splitLeft .ml-Main { box-shadow: 1px 0 0 var(--ml-border); }
              .ml-Layout--splitRight .ml-Card, .ml-Layout--splitLeft .ml-Card {
                padding: 0; background: transparent; box-shadow: none; border: 0; -webkit-backdrop-filter: none; backdrop-filter: none;
              }
              .ml-Layout--floating .ml-Brand, .ml-Layout--floatingLeft .ml-Brand { color: var(--ml-on-bg-strong); }
              .ml-Layout--floating .ml-Main, .ml-Layout--floatingLeft .ml-Main { padding-inline: clamp(1rem, 4vw, 4rem); }
              .ml-Shell:has(.ml-Brand-inner:empty) { grid-template-columns: minmax(0, 1fr); grid-template-areas: "top" "main"; }
              .ml-Shell:has(.ml-Brand-inner:empty) .ml-Brand { display: none; }
            }
            
            /* phones and portrait tablets: the brand panel becomes a banner above the form, the top bar sits on the banner */
            @media (max-width: 860px) {
              :is(.ml-Layout--splitRight, .ml-Layout--splitLeft, .ml-Layout--floating, .ml-Layout--floatingLeft) .ml-Shell {
                grid-template-rows: auto auto 1fr; grid-template-areas: "top" "brand" "main";
              }
              :is(.ml-Layout--splitRight, .ml-Layout--splitLeft, .ml-Layout--floating, .ml-Layout--floatingLeft):not(.ml-Brand-hideMobile) .ml-Shell:has(.ml-Brand-inner:not(:empty)) .ml-TopBar {
                grid-area: brand; align-self: start; background: none; color: var(--ml-on-bg-strong);
              }
              :is(.ml-Layout--splitRight, .ml-Layout--splitLeft):not(.ml-Brand-hideMobile) .ml-Shell:has(.ml-Brand-inner:not(:empty)) .ml-TopBar { color: #ffffff; }
              :is(.ml-Layout--splitRight, .ml-Layout--splitLeft, .ml-Layout--floating, .ml-Layout--floatingLeft) .ml-Shell:has(.ml-TopBar:not(:empty)) .ml-Brand {
                padding-top: calc(4rem + env(safe-area-inset-top)) !important;
              }
              .ml-Layout--splitRight .ml-Brand, .ml-Layout--splitLeft .ml-Brand, .ml-Layout--floating .ml-Brand, .ml-Layout--floatingLeft .ml-Brand {
                display: block; padding: calc(2rem + env(safe-area-inset-top)) 1.25rem 1rem;
              }
              .ml-Layout--splitRight .ml-Brand, .ml-Layout--splitLeft .ml-Brand { padding-bottom: 3rem; }
              .ml-Layout--splitRight .ml-Brand::before, .ml-Layout--splitLeft .ml-Brand::before {
                content: ""; position: absolute; inset: 0;
                background: linear-gradient(150deg, color-mix(in srgb, var(--ml-accent) 82%, transparent), color-mix(in srgb, var(--ml-accent-2) 60%, transparent));
              }
              .ml-Layout--floating .ml-Brand, .ml-Layout--floatingLeft .ml-Brand { color: var(--ml-on-bg-strong); }
              .ml-Brand h1, .ml-Brand h2.ml-Hero-title { font-size: 1.75rem; margin-bottom: .5rem; }
              .ml-Brand p { margin-bottom: 0; font-size: .9375rem; }
              .ml-Brand ul, .ml-Brand blockquote, .ml-Brand .ml-Badge, .ml-Brand .ml-Slides, .ml-Brand .ml-Dots { display: none; }
              .ml-Brand-hideMobile .ml-Brand, .ml-Brand:has(.ml-Brand-inner:empty) { display: none !important; }
              .ml-Layout--splitRight .ml-Main, .ml-Layout--splitLeft .ml-Main {
                --ml-on-bg: var(--ml-muted); --ml-on-bg-strong: var(--ml-text);
                position: relative; margin-top: -1.5rem; border-radius: 24px 24px 0 0; background: var(--ml-surface);
              }
              .ml-Layout--splitRight .ml-Center, .ml-Layout--splitLeft .ml-Center, .ml-Layout--floating .ml-Center, .ml-Layout--floatingLeft .ml-Center { align-items: flex-start; }
              .ml-Brand-hideMobile.ml-Layout--splitRight .ml-Main, .ml-Brand-hideMobile.ml-Layout--splitLeft .ml-Main { margin-top: 0; border-radius: 0; }
              .ml-Brand-hideMobile .ml-Center { align-items: center !important; }
              .ml-Layout--splitRight .ml-Card, .ml-Layout--splitLeft .ml-Card { padding: 0 .25rem; background: transparent; box-shadow: none; border: 0; }
            }
            /* portrait tablets: a roomier, centred banner */
            @media (min-width: 600px) and (max-width: 860px) {
              .ml-Layout--splitRight .ml-Brand, .ml-Layout--splitLeft .ml-Brand, .ml-Layout--floating .ml-Brand, .ml-Layout--floatingLeft .ml-Brand {
                padding: calc(4rem + env(safe-area-inset-top)) 2.5rem 2.5rem; text-align: center;
              }
              .ml-Layout--splitRight .ml-Brand, .ml-Layout--splitLeft .ml-Brand { padding-bottom: 4rem; }
              .ml-Brand-inner { margin-inline: auto; }
              .ml-Brand .ml-Badge { display: inline-flex; margin-bottom: 1rem; }
              .ml-Brand h1, .ml-Brand h2.ml-Hero-title { font-size: 2.5rem; }
              .ml-Brand p { font-size: 1.0625rem; max-width: 32rem; margin-inline: auto; }
              .ml-Center { padding-block: 2.5rem; }
            }
            /* short phones: keep the Sign In button above the fold */
            @media (max-width: 860px) and (max-height: 720px) {
              .ml-Layout--splitRight .ml-Brand, .ml-Layout--splitLeft .ml-Brand, .ml-Layout--floating .ml-Brand, .ml-Layout--floatingLeft .ml-Brand { padding-top: calc(1.25rem + env(safe-area-inset-top)); }
              .ml-Layout--splitRight .ml-Brand, .ml-Layout--splitLeft .ml-Brand { padding-bottom: 2.25rem; }
              .ml-Brand h1, .ml-Brand h2.ml-Hero-title { font-size: 1.5rem; margin-bottom: 0; }
              .ml-Brand p { display: none; }
              .ml-Center { padding-block: 1rem; }
              .ml-Card { padding: 1.5rem 1.25rem; }
              .ml-Card .t-Login-logo { --ut-login-logo-size: 2.75rem; --ut-login-logo-font-size: 1.25rem; margin-bottom: .75rem; }
              .ml-Card .t-Login-header { padding-bottom: 1rem; }
              .ml-Card .t-Login-title { font-size: 1.375rem; }
            }
            /* landscape phones: no banner, compact card */
            @media (max-height: 520px) and (orientation: landscape) {
              .ml-Brand { display: none !important; }
              .ml-Shell { grid-template-columns: minmax(0, 1fr) !important; grid-template-rows: auto 1fr !important; grid-template-areas: "top" "main" !important; }
              .ml-Shell .ml-TopBar { grid-area: top !important; padding-top: calc(.5rem + env(safe-area-inset-top)); color: var(--ml-on-bg-strong) !important; }
              :is(.ml-Layout--splitRight, .ml-Layout--splitLeft) .ml-Shell .ml-TopBar { background: var(--ml-surface); color: var(--ml-text) !important; }
              .ml-Layout--splitRight .ml-Main, .ml-Layout--splitLeft .ml-Main { margin-top: 0; border-radius: 0; }
              .ml-Center { padding-block: .75rem; align-items: center !important; }
              .ml-Card .t-Login-logo { display: none; }
              .ml-Card .t-Login-header { padding-bottom: .75rem; }
              .ml-Page .ml-Lead { margin-bottom: .75rem; }
            }
            /* Edge to Edge on Phones: the card becomes a full-screen sheet */
            @media (max-width: 599px) {
              .ml-Phone--edge .ml-Main { padding-inline: 0; background: var(--ml-surface); --ml-on-bg: var(--ml-muted); --ml-on-bg-strong: var(--ml-text); }
              .ml-Phone--edge .ml-TopBar { background: var(--ml-surface); color: var(--ml-text); }
              .ml-Phone--edge .ml-Center { align-items: stretch; padding-block: 0; }
              .ml-Phone--edge .ml-Card { max-width: none; border: 0; border-radius: 0; box-shadow: none; background: var(--ml-surface);
                                         -webkit-backdrop-filter: none; backdrop-filter: none; padding: 2rem 1.5rem; }
            }
            /* touch screens: no hover lift */
            @media (hover: none) {
              .ml-Page .t-Button--hot:not(.t-Button--simple):not(.t-Button--link):not(.t-Button--noUI):hover { transform: none; filter: none; }
            }
            
            /* call to action in the brand panel, e.g. <a class="ml-Cta" href="...">Create an account</a> */
            .ml-Cta { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; box-sizing: border-box; min-width: 10rem; margin-block-start: .25rem;
                      padding: .75rem 1.75rem; border: 2px solid currentColor; border-radius: var(--ml-control-radius); color: inherit !important;
                      font-weight: 700; text-decoration: none !important; transition: background-color .15s ease; }
            .ml-Cta:hover, .ml-Cta:focus-visible { background: color-mix(in srgb, currentColor 16%, transparent); }
            .ml-Brand .ml-Cta { margin-block-end: .5rem; }
            .ml-Brand .ml-Cta ~ :is(ul, blockquote, .ml-Slides) { margin-block-start: 2rem; }
            /* checkboxes keep a visible edge in designs whose fields have no border */
            .ml-Main { --a-checkbox-border-color: color-mix(in srgb, var(--ml-text) 32%, transparent); }

            /* ================= designs ================= */
            /* panel designs keep the brand panel short: headline, text and call to action */
            :is(.ml-Design--curve, .ml-Design--arc, .ml-Design--wave) .ml-Brand :is(ul, blockquote, .ml-Slides, .ml-Dots, .ml-Badge) { display: none !important; }
            :is(.ml-Design--curve, .ml-Design--arc) .ml-Brand h1, :is(.ml-Design--curve, .ml-Design--arc) .ml-Brand h2.ml-Hero-title { font-size: clamp(1.875rem, 1.3rem + 1.6vw, 2.625rem); margin-bottom: .75rem; }
            :is(.ml-Design--curve, .ml-Design--arc) .ml-Brand p { margin-bottom: 1.5rem; font-size: 1rem; }
            :is(.ml-Design--curve, .ml-Design--arc, .ml-Design--neon, .ml-Design--terminal) .ml-Card .t-Login-logo { display: none; }
            :is(.ml-Design--curve, .ml-Design--arc) .ml-Card .t-Login-title { font-size: clamp(2rem, 1.6rem + 1vw, 2.5rem); font-weight: 800; }

            /* Curved Panel: one card, a coloured panel with a big curve next to the form */
            /* the card is centred with auto margins: APEX puts hidden inputs next to it in the form */
            body.ml-Design--curve #wwvFlowForm { display: flex; flex-direction: column; box-sizing: border-box; min-height: 100vh; min-height: 100dvh; padding: clamp(.75rem, 4vh, 3rem) clamp(.75rem, 3vw, 2rem); }
            body.ml-Design--curve .ml-Shell { margin: auto; width: min(60rem, 100%); min-height: 0; grid-template-columns: minmax(0, 1fr); grid-template-rows: auto auto 1fr;
                                              grid-template-areas: "top" "brand" "main"; border-radius: var(--ml-radius); background: var(--ml-surface);
                                              box-shadow: 0 30px 70px -24px rgba(0, 0, 0, .45); overflow: hidden; }
            body.ml-Design--curve .ml-Brand { display: block; padding: calc(2.5rem + env(safe-area-inset-top)) 1.5rem 3rem; text-align: center; color: var(--ml-on-accent);
                                              background: var(--ml-panel-bg); border-radius: 0 0 50% 50% / 0 0 2.5rem 2.5rem; }
            body.ml-Design--curve .ml-Brand-inner { margin-inline: auto; }
            body.ml-Design--curve .ml-TopBar { color: var(--ml-text); }
            @media (max-width: 860px) {
              body.ml-Design--curve .ml-Shell:has(.ml-Brand-inner:not(:empty)) .ml-TopBar { grid-area: brand; align-self: start; z-index: 2; color: var(--ml-on-accent); }
              body.ml-Design--curve .ml-Shell:has(.ml-TopBar:not(:empty)) .ml-Brand { padding-top: calc(4rem + env(safe-area-inset-top)); }
            }
            body.ml-Design--curve .ml-Main { padding: 0 clamp(1rem, 4vw, 3.5rem) 1.5rem; }
            body.ml-Design--curve .ml-Card { max-width: 22rem; padding: 0; background: transparent; box-shadow: none; border: 0; -webkit-backdrop-filter: none; backdrop-filter: none; }
            body.ml-Design--curve .ml-Center { padding-block: 2rem; }
            @media (min-width: 861px) {
              body.ml-Design--curve .ml-Shell { min-height: 34rem; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); grid-template-rows: auto 1fr; grid-template-areas: "brand top" "brand main"; }
              body.ml-Design--curve .ml-Brand { display: flex; align-items: center; justify-content: center; padding: 3rem 4rem 3rem 2.75rem; border-radius: 0 12rem 12rem 0; }
              body.ml-Design--curve .ml-Brand-inner { max-width: 22rem; }
              body.ml-Design--curve .ml-TopBar { padding-inline: clamp(1.5rem, 4vw, 3.5rem); }
              body.ml-Design--curve .ml-Center { padding-block: 2.5rem; }
            }

            /* Arc: a big coloured circle sweeps in from the side, the form sits on white */
            body.ml-Design--arc .ml-Shell { grid-template-rows: auto auto 1fr; grid-template-areas: "top" "brand" "main"; overflow: hidden; }
            body.ml-Design--arc .ml-TopBar { grid-area: top; color: var(--ml-text); }
            body.ml-Design--arc .ml-Shell:has(.ml-Brand-inner:not(:empty)) .ml-TopBar { grid-area: brand; align-self: start; color: var(--ml-on-accent); }
            body.ml-Design--arc .ml-Brand { display: block; padding: calc(4rem + env(safe-area-inset-top)) 1.5rem 3.5rem; text-align: center; color: var(--ml-on-accent); }
            body.ml-Design--arc .ml-Brand::before { content: ""; position: absolute; z-index: 0; inset: 0 -30%; border-radius: 0 0 50% 50%; background: var(--ml-panel-bg); }
            body.ml-Design--arc .ml-Brand-inner { margin-inline: auto; }
            body.ml-Design--arc .ml-Brand:has(.ml-Brand-inner:empty) { display: none; }
            body.ml-Design--arc .ml-Card { background: transparent; box-shadow: none; border: 0; -webkit-backdrop-filter: none; backdrop-filter: none; }
            @media (min-width: 861px) {
              body.ml-Design--arc .ml-Shell { grid-template-columns: minmax(0, 1fr) minmax(24rem, 42%); grid-template-rows: auto 1fr; grid-template-areas: "brand top" "brand main"; }
              body.ml-Design--arc .ml-Shell:has(.ml-Brand-inner:not(:empty)) .ml-TopBar { grid-area: top; align-self: auto; color: var(--ml-text); padding-inline: clamp(1.5rem, 4vw, 4rem); }
              body.ml-Design--arc .ml-Brand { display: flex; align-items: center; justify-content: center; padding: 3rem 9% 3rem 3rem; }
              body.ml-Design--arc .ml-Brand::before { inset: auto; top: 50%; right: 0; width: max(190vh, 140%); aspect-ratio: 1; border-radius: 50%; transform: translateY(-50%); }
              body.ml-Design--arc .ml-Main { padding-inline: clamp(1.5rem, 4vw, 4rem); }
              body.ml-Design--arc .ml-Shell:has(.ml-Brand-inner:empty) { grid-template-columns: minmax(0, 1fr); grid-template-areas: "top" "main"; }
            }

            /* Neon: dark card, glowing corner lines and a glowing button */
            .ml-Design--neon .ml-Card::before, .ml-Design--neon .ml-Card::after { content: ""; position: absolute; width: 52%; height: 46%; pointer-events: none; border-radius: 3px; }
            .ml-Design--neon .ml-Card::before { top: -3px; right: -3px; border-top: 2px solid var(--ml-accent); border-right: 2px solid var(--ml-accent); filter: drop-shadow(0 0 6px var(--ml-accent)); }
            .ml-Design--neon .ml-Card::after { bottom: -3px; left: -3px; border-bottom: 2px solid var(--ml-accent-2); border-left: 2px solid var(--ml-accent-2); filter: drop-shadow(0 0 6px var(--ml-accent-2)); }
            .ml-Design--neon .ml-Card .t-Login-header, .ml-Design--neon .ml-Card-header { align-items: flex-start; text-align: start; }
            .ml-Design--neon .ml-Card .t-Login-title { color: var(--ml-accent); font-size: 2rem; text-shadow: 0 0 18px color-mix(in srgb, var(--ml-accent) 45%, transparent); }
            .ml-Design--neon .ml-Lead { text-align: start; }
            .ml-Design--neon .ml-Card-footer a, .ml-Design--neon .ml-Card-body a { color: var(--ml-accent-2); }
            .ml-Page.ml-Design--neon .t-Button--hot:not(.t-Button--simple):not(.t-Button--link):not(.t-Button--noUI) {
              background-image: none; box-shadow: 0 0 22px color-mix(in srgb, var(--ml-accent) 70%, transparent), 0 0 46px color-mix(in srgb, var(--ml-accent) 30%, transparent);
            }

            /* Soft UI: the card and the fields are pressed out of / into the page */
            .ml-Design--soft .ml-Card { border: 0; }
            .ml-Design--soft .ml-Main { --a-checkbox-border-color: color-mix(in srgb, var(--ml-text) 28%, transparent); }
            .ml-Design--soft .ml-Card .apex-item-text, .ml-Design--soft .ml-Card .apex-item-select, .ml-Design--soft .ml-Card .t-Button--passwordVisibility {
              border-color: transparent !important; box-shadow: inset 5px 5px 10px var(--ml-soft-dark), inset -5px -5px 10px var(--ml-soft-light);
            }
            .ml-Design--soft .ml-Card .apex-item-text:focus, .ml-Design--soft .ml-Card .apex-item-select:focus {
              box-shadow: inset 5px 5px 10px var(--ml-soft-dark), inset -5px -5px 10px var(--ml-soft-light), 0 0 0 3px color-mix(in srgb, var(--ml-accent) 35%, transparent);
            }
            .ml-Design--soft .ml-Card .t-Login-logo { background: var(--ml-bg); color: var(--ml-accent); box-shadow: 7px 7px 16px var(--ml-soft-dark), -7px -7px 16px var(--ml-soft-light); }
            .ml-Scheme--dark.ml-Design--soft .ml-Card .t-Login-logo { color: var(--ml-accent-2); }
            .ml-Page.ml-Design--soft .t-Button--hot:not(.t-Button--simple):not(.t-Button--link):not(.t-Button--noUI) { box-shadow: 7px 7px 16px var(--ml-soft-dark), -7px -7px 16px var(--ml-soft-light); }

            /* Minimal Line: no card, a big title, underlined fields */
            .ml-Design--line .ml-Card { padding-inline: 0; background: transparent; box-shadow: none; border: 0; -webkit-backdrop-filter: none; backdrop-filter: none; }
            .ml-Design--line .ml-Card .t-Login-header, .ml-Design--line .ml-Card-header { align-items: flex-start; text-align: start; }
            .ml-Design--line .ml-Card .t-Login-logo { --ut-login-logo-size: 2.75rem; --ut-login-logo-font-size: 1.125rem; --ut-login-logo-border-radius: 10px; box-shadow: none; }
            .ml-Design--line .ml-Card .t-Login-title { font-size: clamp(2.25rem, 1.6rem + 1.8vw, 3rem); font-weight: 800; letter-spacing: -.045em; }
            .ml-Design--line .ml-Lead { text-align: start; }
            .ml-Design--line .ml-Card .apex-item-text, .ml-Design--line .ml-Card .apex-item-select, .ml-Design--line .ml-Card .t-Button--passwordVisibility {
              border-width: 0 0 2px !important; border-radius: 0 !important; background: transparent !important;
            }
            .ml-Design--line .ml-Card .apex-item-text:focus, .ml-Design--line .ml-Card .apex-item-select:focus { box-shadow: 0 2px 0 0 var(--ml-accent); }
            .ml-Design--line .ml-Card-footer { border: 0; padding-block-start: 0; text-align: start; }
            .ml-Page.ml-Design--line .t-Button--hot:not(.t-Button--simple):not(.t-Button--link):not(.t-Button--noUI) { background-image: none; box-shadow: none; }

            /* Diagonal and Wave: the card floats over a two-tone page */
            .ml-Page:is(.ml-Design--diagonal, .ml-Design--wave) { --ml-on-bg-strong: #ffffff; }
            .ml-Design--wave .ml-Center { align-items: flex-start; padding-block-start: max(14vh, 4.5rem); }
            @media (max-width: 860px) {
              .ml-Design--diagonal .ml-Bg { background: linear-gradient(160deg, var(--ml-accent) 0 30%, var(--ml-accent-2) 30% 32%, var(--ml-bg) 32%); }
              .ml-Design--wave .ml-Bg::before { height: max(34vh, 14rem); }
              .ml-Design--wave .ml-Center { padding-block-start: max(9vh, 3.5rem); }
            }

            /* Bold: thick ink outlines and hard offset shadows */
            .ml-Design--bold .ml-Card { border: 3px solid var(--ml-ink); }
            .ml-Design--bold .ml-Card .apex-item-text, .ml-Design--bold .ml-Card .apex-item-select { border-width: 2px; border-color: var(--ml-ink); }
            .ml-Design--bold .ml-Card .apex-item-text:focus, .ml-Design--bold .ml-Card .apex-item-select:focus { border-color: var(--ml-ink); box-shadow: 4px 4px 0 var(--ml-accent); }
            .ml-Design--bold .ml-Card .t-Button--passwordVisibility { border: 2px solid var(--ml-ink); border-inline-start: 0; }
            .ml-Design--bold .ml-Card .t-Login-logo { background: var(--ml-accent-2); background-image: none; color: var(--ml-ink); border: 2px solid var(--ml-ink); box-shadow: 4px 4px 0 var(--ml-ink); }
            .ml-Design--bold .ml-Card .t-Login-title { font-weight: 900; letter-spacing: -.035em; }
            .ml-Page.ml-Design--bold .t-Button--hot:not(.t-Button--simple):not(.t-Button--link):not(.t-Button--noUI) {
              --a-button-border-color: var(--ml-ink); --a-button-hover-border-color: var(--ml-ink); --a-button-focus-border-color: var(--ml-ink);
              background-image: none; border: 2px solid var(--ml-ink); box-shadow: 4px 4px 0 var(--ml-ink); font-weight: 800;
            }
            .ml-Page.ml-Design--bold .t-Button--hot:not(.t-Button--simple):not(.t-Button--link):not(.t-Button--noUI):hover { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--ml-ink); filter: none; }
            .ml-Page.ml-Design--bold .t-Button--hot:not(.t-Button--simple):not(.t-Button--link):not(.t-Button--noUI):active { transform: translate(3px, 3px); box-shadow: 0 0 0 var(--ml-ink); }
            .ml-Design--bold .ml-Cta { border-width: 3px; box-shadow: 4px 4px 0 currentColor; }

            /* Gradient Border: a turning colour ring around the card */
            .ml-Design--border .ml-Card {
              border: 2px solid transparent; -webkit-backdrop-filter: none; backdrop-filter: none;
              background: linear-gradient(var(--ml-surface), var(--ml-surface)) padding-box,
                          conic-gradient(from var(--ml-angle, 0deg), var(--ml-accent), var(--ml-accent-2), color-mix(in srgb, var(--ml-accent) 25%, transparent), var(--ml-accent)) border-box;
              box-shadow: 0 0 70px -24px var(--ml-accent), var(--ml-shadow);
            }
            .ml-Page.ml-Design--border.ml-Anim--bg .ml-Card { animation: ml-border 6s linear infinite; }
            .ml-Page.ml-Design--border.ml-Anim--bg.ml-Anim--entrance .ml-Card { animation: ml-rise .7s cubic-bezier(.2, .8, .2, 1) both, ml-border 6s linear infinite; }
            .ml-Page.ml-Design--border .ml-Card.ml-is-shaking { animation: ml-shake .5s cubic-bezier(.36, .07, .19, .97) both; }

            /* Layered Cards: two coloured cards fanned out behind the form */
            /* align-content: the grid row hugs the card, so the fanned cards are exactly as tall as the form */
            body.ml-Design--layered .ml-Center { display: grid; place-items: center; align-content: center; }
            body.ml-Design--layered .ml-Main { overflow-x: clip; }
            body.ml-Design--layered .ml-Center > .ml-Card { grid-area: 1 / 1; z-index: 2; }
            body.ml-Design--layered .ml-Center::before, body.ml-Design--layered .ml-Center::after {
              content: ""; grid-area: 1 / 1; align-self: stretch; justify-self: center; box-sizing: border-box; width: 100%; max-width: var(--ml-width); border-radius: var(--ml-radius);
            }
            body.ml-Design--layered .ml-Center::before { z-index: 0; background: linear-gradient(135deg, var(--ml-accent), color-mix(in srgb, var(--ml-accent) 70%, #000000)); transform: rotate(-7deg) translate(-4%, 3%); }
            body.ml-Design--layered .ml-Center::after { z-index: 1; background: var(--ml-accent-2); opacity: .85; transform: rotate(4deg) translate(4%, 1%); }

            </style>
              #THEME_STYLE_CSS#
              #APPLICATION_CSS#
              #PAGE_CSS#
              #FAVICONS#
              #HEAD#
              <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
              <meta name="app-version" content="&APP_VERSION!ATTR." />
              <meta name="app-tenant-id" content="&APP_TENANT_ID!ATTR." />
              <meta name="app-alias" content="&APP_ALIAS!ATTR." />
              <meta name="app-page-alias" content="&APP_PAGE_ALIAS!ATTR." />
            </head>
            <body class="t-PageBody--login ml-Page no-anim #PAGE_CSS_CLASSES#" #TEXT_DIRECTION# #ONLOAD#>
            <script>
            /* Modern Login: runs before the first paint so the chosen look never flickers.
               - Theme Toggle option: the visitor's own light/dark choice (localStorage "ml-scheme").
               - Login Designer preview: template options passed in the URL hash (#ml=ml-Layout--splitLeft ...). */
            window.modernLogin = (function (body) {
              var LOOK = /^ml-(Design|Layout|Bg|CardStyle|Accent|Scheme|Width|Corners|Header|Anim|Brand|Split|Phone|Fx)-/;
              function isDark() {
                return body.classList.contains("ml-Scheme--dark") ||
                       (body.classList.contains("ml-Scheme--auto") && window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches);
              }
              function applyPreview() {
                var m = /[#&]ml=([^&]*)/.exec(window.location.hash);
                if (!m) { return; }
                Array.prototype.slice.call(body.classList).forEach(function (c) { if (LOOK.test(c)) { body.classList.remove(c); } });
                decodeURIComponent(m[1]).split(/[\s,]+/).forEach(function (c) { if (LOOK.test(c)) { body.classList.add(c); } });
              }
              function applyScheme() {
                var s = null;
                if (!body.classList.contains("ml-Fx--themeToggle")) { return; }
                try { s = window.localStorage.getItem("ml-scheme"); } catch (e) { s = null; }
                if (s !== "dark" && s !== "light") { return; }
                body.classList.remove("ml-Scheme--dark", "ml-Scheme--auto");
                if (s === "dark") { body.classList.add("ml-Scheme--dark"); }
              }
              try { applyPreview(); applyScheme(); } catch (e) { /* never block the sign-in page */ }
              return { isDark: isDark, applyPreview: applyPreview, applyScheme: applyScheme };
            })(document.body);
            </script>
            <noscript class="t-PageBody-noScript">&APP_TEXT$APEX_PAGE_NOSCRIPT.</noscript>
            #FORM_OPEN#
            <div class="ml-Bg" aria-hidden="true">
              <div class="ml-Bg-media">#BACKGROUND_IMAGE#</div>
              <span class="ml-Bg-blob ml-Bg-blob--1"></span>
              <span class="ml-Bg-blob ml-Bg-blob--2"></span>
              <span class="ml-Bg-blob ml-Bg-blob--3"></span>
            </div>
            <script>
            /* Background image: the picture in the Background Image slot is also offered to the designs as
               --ml-bg-image (Curved Panel, Arc and Wave show it inside their panel). The Login Designer can
               swap it for one of the application's images: #...&bg=<file path> */
            (function (body) {
              try {
                var media = document.querySelector(".ml-Bg-media"), img = media && media.querySelector("img"),
                    m = /[#&]bg=([^&]*)/.exec(window.location.hash), src = null;
                if (m) {
                  src = decodeURIComponent(m[1]);
                  if (!/^[\w\-.\/%]+\.(png|jpe?g|webp|svg|avif)$/i.test(src) || /^\/\/|\.\./.test(src)) { src = null; }
                  else if (img) { img.src = src; }
                  else { img = new Image(); img.alt = ""; img.src = src; media.appendChild(img); }
                }
                if (img) { body.style.setProperty("--ml-bg-image", 'url("' + (src || img.currentSrc || img.src).replace(/["\\()]/g, "") + '")'); }
              } catch (e) { /* never block the sign-in page */ }
            })(document.body);
            </script>
            <button type="button" class="ml-ThemeToggle" aria-label="Switch between light and dark">
              <svg class="ml-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
              <svg class="ml-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            </button>
