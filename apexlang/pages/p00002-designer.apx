    button copy (
        buttonName: COPY
        label: Copy APEXlang
        layout {
            sequence: 10
            region: @summary
            slot: edit
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
                t-Button--small
            ]
            cssClasses: js-lsd-copy
            icon: fa-copy
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button open-full (
        buttonName: OPEN_FULL
        label: Open Full Page
        layout {
            sequence: 20
            region: @preview
            slot: edit
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: js-lsd-open
            icon: fa-external-link
        }
        behavior {
            action: definedByDynamicAction
        }
    )

)
