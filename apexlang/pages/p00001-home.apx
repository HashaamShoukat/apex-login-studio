page 1 (
    name: Gallery
    alias: HOME
    title: Login Studio - Gallery
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            // Ready-made looks of the Modern Login template. Each one is a set of template options (body classes);
            // thumbnails are app files gallery/<id>.jpg (made from the real login page).
            var LS_PRESETS = [
                { id: "curve-wine",     name: "Curved Panel",           tags: "light panel",  cls: "ml-Design--curve" },
                { id: "curve-dunes",    name: "Curved Panel - Image",   tags: "light panel image", cls: "ml-Design--curve ml-Bg--image", bg: "bg-dunes.svg" },
                { id: "arc",            name: "Arc",                    tags: "light panel",  cls: "ml-Design--arc" },
                { id: "arc-dusk",       name: "Arc - Image",            tags: "light panel image", cls: "ml-Design--arc ml-Accent--violet ml-Bg--image", bg: "bg-dusk.svg" },
                { id: "neon",           name: "Neon",                   tags: "dark",         cls: "ml-Design--neon" },
                { id: "neon-rose",      name: "Neon - Rose",            tags: "dark",         cls: "ml-Design--neon ml-Accent--rose" },
                { id: "soft",           name: "Soft UI",                tags: "light",        cls: "ml-Design--soft" },
                { id: "soft-dark",      name: "Soft UI - Dark",         tags: "dark",         cls: "ml-Design--soft ml-Scheme--dark ml-Accent--cyan" },
                { id: "line",           name: "Minimal Line",           tags: "light",        cls: "ml-Design--line ml-Accent--slate" },
                { id: "diagonal",       name: "Diagonal",               tags: "light",        cls: "ml-Design--diagonal ml-Accent--emerald" },
                { id: "wave",           name: "Wave",                   tags: "light",        cls: "ml-Design--wave ml-Accent--ocean" },
                { id: "wave-dusk",      name: "Wave - Image",           tags: "light image",  cls: "ml-Design--wave ml-Accent--tangerine ml-Bg--image", bg: "bg-dusk.svg" },
                { id: "bold",           name: "Bold",                   tags: "light",        cls: "ml-Design--bold" },
                { id: "bold-dark",      name: "Bold - Dark",            tags: "dark",         cls: "ml-Design--bold ml-Scheme--dark ml-Accent--indigo" },
                { id: "border",         name: "Gradient Border",        tags: "dark",         cls: "ml-Design--border ml-Scheme--dark" },
                { id: "layered",        name: "Layered Cards",          tags: "light",        cls: "ml-Design--layered ml-Accent--rose" },
                { id: "editorial",      name: "Editorial",              tags: "light",        cls: "ml-Design--editorial" },
                { id: "terminal",       name: "Terminal",               tags: "dark",         cls: "ml-Design--terminal" },
                { id: "glass",          name: "Glass over Image",       tags: "image panel",  cls: "ml-Layout--floating ml-Bg--image ml-CardStyle--glass ml-Accent--violet", bg: "login-bg.svg" },
                { id: "split-lowpoly",  name: "Split - Image",          tags: "light image panel", cls: "ml-Layout--splitRight ml-Bg--image ml-Accent--indigo", bg: "bg-lowpoly.svg" },
                { id: "aurora",         name: "Aurora",                 tags: "light",        cls: "" },
                { id: "peaks",          name: "Peaks",                  tags: "light",        cls: "ml-Bg--peaks ml-Accent--ocean" },
                { id: "topo",           name: "Topography",             tags: "light",        cls: "ml-Bg--topo ml-Accent--amber ml-Header--start" },
                { id: "waves",          name: "Waves",                  tags: "light",        cls: "ml-Bg--waves ml-Accent--indigo" },
                { id: "rings",          name: "Rings",                  tags: "light",        cls: "ml-Bg--rings ml-Accent--tangerine ml-CardStyle--outline" },
                { id: "grid-dark",      name: "Grid Lines - Dark",      tags: "dark",         cls: "ml-Bg--grid ml-Scheme--dark ml-Accent--cyan" },
                { id: "mesh-floating",  name: "Mesh - Floating Panel",  tags: "light panel",  cls: "ml-Layout--floating ml-Bg--mesh ml-Accent--emerald ml-CardStyle--glass" },
                { id: "gradient-split", name: "Bold Gradient - Split",  tags: "light panel",  cls: "ml-Layout--splitLeft ml-Bg--gradient ml-Accent--rose" }
            ];
            // the template's #DEFAULT# behaviour options, kept in every preview
            var LS_DEFAULTS = "ml-Anim--entrance ml-Anim--bg ml-Fx--busy ml-Fx--shake ml-Fx--offline ml-Fx--slides";
            ```
        executeWhenPageLoads:
            ```javascript-browser
            (function ($) {
                var box = document.getElementById("ls-gallery"),
                    files = box.getAttribute("data-files"),
                    loginUrl = box.getAttribute("data-login"),
                    designerUrl = box.getAttribute("data-designer");
                function hash(p) {
                    return "#ml=" + encodeURIComponent((LS_DEFAULTS + " " + p.cls).trim()) + (p.bg ? "&bg=" + encodeURIComponent(files + p.bg) : "");
                }
                function esc(s) { return apex.util.escapeHTML(String(s)); }
                box.innerHTML = LS_PRESETS.map(function (p) {
                    return '<article class="ls-Card" data-tags="' + esc(p.tags) + '">' +
                        '<a class="ls-Card-shot" href="' + esc(designerUrl + hash(p)) + '" aria-label="' + esc("Customize " + p.name) + '">' +
                        '<img src="' + esc(files + "gallery/" + p.id + ".jpg") + '" alt="" loading="lazy" width="640" height="400"></a>' +
                        '<div class="ls-Card-body"><h3 class="ls-Card-title">' + esc(p.name) + '</h3>' +
                        '<div class="ls-Card-tags">' + p.tags.split(" ").map(function (t) { return '<span>' + esc(t) + '</span>'; }).join("") + '</div>' +
                        '<div class="ls-Card-actions">' +
                        '<a class="t-Button t-Button--small t-Button--hot" href="' + esc(designerUrl + hash(p)) + '"><span class="t-Button-label">Customize</span></a>' +
                        '<a class="t-Button t-Button--small" target="_blank" rel="noopener" href="' + esc(loginUrl + hash(p)) + '"><span class="t-Button-label">Full Screen</span></a>' +
                        '</div></div></article>';
                }).join("");
                // filter chips
                $(document).on("click", ".ls-Filter button", function () {
                    var f = this.getAttribute("data-f");
                    $(".ls-Filter button").attr("aria-pressed", "false");
                    this.setAttribute("aria-pressed", "true");
                    $(".ls-Card").each(function () {
                        this.hidden = !!f && (" " + this.getAttribute("data-tags") + " ").indexOf(" " + f + " ") < 0;
                    });
                });
            })(apex.jQuery);
            ```
    }
    css {
        inline:
            ```css
            .ls-Hero { padding: clamp(1.5rem, 4vw, 3rem) clamp(1rem, 3vw, 2rem); border-radius: 18px; color: #ffffff;
                       background: radial-gradient(circle at 85% 20%, rgba(255,255,255,.18), transparent 40%), linear-gradient(120deg, #4c1d95, #7c3aed 45%, #db2777); }
            .ls-Hero h1 { margin: 0 0 .5rem; font-size: clamp(1.75rem, 1.2rem + 2vw, 2.75rem); font-weight: 800; letter-spacing: -.03em; line-height: 1.1; }
            .ls-Hero p { max-width: 46rem; margin: 0 0 1.25rem; font-size: 1.0625rem; line-height: 1.6; opacity: .92; }
            .ls-Hero .t-Button { margin: 0 .5rem .5rem 0; }
            .ls-Hero .t-Button--hot { --a-button-background-color: #ffffff; --a-button-text-color: #4c1d95; --a-button-hover-background-color: #f3e8ff; --a-button-hover-text-color: #4c1d95; }
            .ls-Hero .ls-Ghost { --a-button-background-color: transparent; --a-button-text-color: #ffffff; --a-button-border-color: rgba(255,255,255,.6);
                                 --a-button-hover-background-color: rgba(255,255,255,.14); --a-button-hover-text-color: #ffffff; border: 1px solid rgba(255,255,255,.6); }
            .ls-Filter { display: flex; flex-wrap: wrap; gap: .5rem; margin: 1.5rem 0 1rem; }
            .ls-Filter button { padding: .375rem .95rem; border-radius: 999px; border: 1px solid var(--ut-component-border-color, #d0d5dd);
                                background: var(--ut-component-background-color, #fff); color: inherit; font: inherit; font-size: .875rem; cursor: pointer; }
            .ls-Filter button[aria-pressed="true"] { background: #4c1d95; border-color: #4c1d95; color: #ffffff; }
            .ls-Grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr)); gap: 1.25rem; }
            .ls-Card { display: flex; flex-direction: column; overflow: hidden; border-radius: 14px; border: 1px solid var(--ut-component-border-color, #e4e7ec);
                       background: var(--ut-component-background-color, #fff); box-shadow: 0 1px 2px rgba(16,24,40,.05); transition: box-shadow .2s ease, transform .2s ease; }
            .ls-Card:hover { transform: translateY(-2px); box-shadow: 0 18px 40px -18px rgba(16,24,40,.35); }
            .ls-Card[hidden] { display: none; }
            .ls-Card-shot { display: block; aspect-ratio: 16 / 10; overflow: hidden; background: #eef0f4; }
            .ls-Card-shot img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .4s ease; }
            .ls-Card:hover .ls-Card-shot img { transform: scale(1.03); }
            .ls-Card-body { display: flex; flex-direction: column; gap: .5rem; padding: .875rem 1rem 1rem; }
            .ls-Card-title { margin: 0; font-size: 1rem; font-weight: 700; }
            .ls-Card-tags { display: flex; flex-wrap: wrap; gap: .375rem; }
            .ls-Card-tags span { padding: .1rem .5rem; border-radius: 999px; background: rgba(124,58,237,.1); color: #6d28d9; font-size: .75rem; font-weight: 600; text-transform: capitalize; }
            .ls-Card-actions { display: flex; gap: .5rem; margin-top: .25rem; }
            .ls-Card-actions .t-Button { flex: 1; justify-content: center; }
            ```
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region hero (
        name: Login Studio
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="ls-Hero">
                  <h1>Sign-in pages for Oracle APEX</h1>
                  <p>One page template with 13 designs, built-in artwork backgrounds, your own images, light and dark - every look is a template option, nothing to code. Pick a look, fine-tune it in the Designer, then copy the template into your app.</p>
                  <a class="t-Button t-Button--hot" href="f?p=&APP_ID.:DESIGNER:&APP_SESSION."><span class="t-Button-label">Open the Designer</span></a>
                  <a class="t-Button ls-Ghost" href="f?p=&APP_ID.:HOW-TO-USE:&APP_SESSION."><span class="t-Button-label">How to use it</span></a>
                </div>
                <div class="ls-Filter" role="group" aria-label="Filter">
                  <button type="button" data-f="" aria-pressed="true">All</button>
                  <button type="button" data-f="light" aria-pressed="false">Light</button>
                  <button type="button" data-f="dark" aria-pressed="false">Dark</button>
                  <button type="button" data-f="panel" aria-pressed="false">With a panel</button>
                  <button type="button" data-f="image" aria-pressed="false">With an image</button>
                </div>
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region gallery (
        name: Gallery
        type: staticContent
        source {
            htmlCode: <div class="ls-Grid" id="ls-gallery" data-files="#APP_FILES#" data-login="f?p=&APP_ID.:LOGIN:&APP_SESSION." data-designer="f?p=&APP_ID.:DESIGNER:&APP_SESSION."></div>
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

)
